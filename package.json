{
  "name": "@avalonreset/legends-obs",
  "version": "0.1.2",
  "description": "Guarded, agent-first control and proof for OBS Studio on Windows.",
  "license": "MIT",
  "author": "Avalon Reset contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avalonreset/legends-obs.git"
  },
  "homepage": "https://cto-legends.com",
  "bugs": {
    "url": "https://github.com/avalonreset/legends-obs/issues"
  },
  "keywords": [
    "obs-studio",
    "obs-websocket",
    "obs-cli",
    "agent-skill",
    "automation",
    "recording",
    "screen-recording"
  ],
  "type": "module",
  "bin": {
    "legends-obs": "./dist/index.js",
    "legends-obs-kit": "./dist/index.js",
    "lobs": "./dist/index.js"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "assets/banner.webp",
    "presets/hdr-4k60-av1-balanced.json",
    "presets/hdr-4k60-av1-hybrid-mp4.json",
    "skills",
    ".legends-module",
    ".legends-router-pin",
    "AGENTS.md",
    "CHANGELOG.md",
    "CITATION.cff",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "SUPPORT.md",
    "THIRD_PARTY_NOTICES.md",
    "extras/cursor"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "pack:check": "node scripts/check-package-contents.mjs",
    "release:check": "node scripts/check-packed-release.mjs",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@10.33.0"
}